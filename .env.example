# ──────────────────────────────────────────────────────────────────────────────
# Template — copy to .env and fill in real values
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
CONNECTIONSTRINGS__POSTGRESCONNECTION=Host=localhost;Port=5432;Database=DBSol;Username=YOUR_USER;Password=YOUR_PASSWORD

# JWT — use a random string of at least 32 characters for the key
JWT__KEY=your-random-secret-key-at-least-32-chars
JWT__ISSUER=BancoSolWalletApi
JWT__AUDIENCE=BancoSolWalletClient
JWT__EXPIRATIONMINUTES=60
